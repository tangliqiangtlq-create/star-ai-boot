<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>org.jeecgframework.boot</groupId>
    <artifactId>star-ai-module-system</artifactId>
    <version>3.7.0</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>star-ai-system-biz</artifactId>

  <dependencies>
    <!--Explicitly rely on base-core to ensure that IDEA can parse DictModelMany, DictModel and other VOs when compiling Mapper/XML.-->
    <dependency>
      <groupId>org.jeecgframework.boot</groupId>
      <artifactId>star-ai-boot-base-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jeecgframework.boot</groupId>
      <artifactId>star-ai-system-local-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-core</artifactId>
    </dependency>
    <!--hibernate-re (Online form) is still based on javax.servlet, and CNF HttpServletRequest will be included in Boot3/Jakarta; local and cloud will not be introduced for the time being.-->

    <dependency>
      <groupId>com.xuxueli</groupId>
      <artifactId>xxl-job-core</artifactId>
    </dependency>


    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-freemarker</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mvel</groupId>
      <artifactId>mvel2</artifactId>
    </dependency>


    <!--Enterprise WeChat/DingTalk API-->
    <dependency>
      <groupId>org.jeecgframework</groupId>
      <artifactId>jeewx-api</artifactId>
      <exclusions>
        <!--jeewx-api 1.5.2 passes the old version org.jdom:jdom:1.1.3; the qywx interface used by the current system module does not directly hit the XML parsing chain, and the old component is cut off first to pass SCA.-->
        <exclusion>
          <groupId>org.jdom</groupId>
          <artifactId>jdom</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- JimuReport -->
    <dependency>
      <groupId>org.jeecgframework.jimureport</groupId>
      <artifactId>jimureport-spring-boot-starter</artifactId>
      <exclusions>
        <exclusion>
          <groupId>commons-lang</groupId>
          <artifactId>commons-lang</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.jeecgframework.jimureport</groupId>
      <artifactId>drag-free</artifactId>
    </dependency>


    <dependency>
      <groupId>com.huaweicloud</groupId>
      <artifactId>esdk-obs-java</artifactId>
    </dependency>


    <dependency>
      <groupId>io.github.huaweicloud</groupId>
      <artifactId>lts-sdk-common</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-simple</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.github.huaweicloud</groupId>
      <artifactId>lts-sdk-logback</artifactId>
    </dependency>

    <dependency>
      <groupId>org.dromara.x-file-storage</groupId>
      <artifactId>x-file-storage-spring</artifactId>
    </dependency>


    <dependency>
      <groupId>com.volcengine</groupId>
      <artifactId>ve-tos-java-sdk</artifactId>

    </dependency>


    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>

    <!--Building block report mongo redis support package
<dependency>
<groupId>org.jeecgframework.jimureport</groupId>
<artifactId>jimureport-nosql-starter</artifactId>
</dependency>-->

    <!--============ KYC module M6 unit test dependency ============-->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <!--JUnit 4 Vintage mode: exclude junit-jupiter and keep junit 4 engine-->
        <exclusion>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
