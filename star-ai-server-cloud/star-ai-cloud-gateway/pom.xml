<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>star-ai-server-cloud</artifactId>
    <groupId>org.jeecgframework.boot</groupId>
    <version>3.7.0</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>star-ai-cloud-gateway</artifactId>
  <properties>
    <!-- Reuse parent-managed Nacos 2.x compatibility version -->
    <gateway.nacos.client.version>${nacos.client.version}</gateway.nacos.client.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.alibaba.nacos</groupId>
        <artifactId>nacos-client</artifactId>
        <version>${gateway.nacos.client.version}</version>
      </dependency>
      <dependency>
        <groupId>com.alibaba.nacos</groupId>
        <artifactId>nacos-common</artifactId>
        <version>${gateway.nacos.client.version}</version>
      </dependency>
      <dependency>
        <groupId>com.alibaba.nacos</groupId>
        <artifactId>nacos-api</artifactId>
        <version>${gateway.nacos.client.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--The tomcat annotations-api passed before rocketmq ensures that javax.annotation.Resource (including lookup) comes from the complete JSR-250-->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <!--jeecg microservice basic dependencies-->
    <dependency>
      <groupId>org.jeecgframework.boot</groupId>
      <artifactId>jeecg-boot-starter-cloud</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.jeecgframework.boot</groupId>
          <artifactId>star-ai-system-cloud-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--
      G07 secrets backend: makes the gateway load encrypted parameters the same way as the WebMvc
      services, by decrypting AESGCM values from /run/secrets with master.key through the
      MpaySecretsEnvironmentPostProcessor injected into the Spring Environment.
      It must be this servlet-free module rather than star-ai-boot-base-core, because base-core brings
      spring-boot-starter-web/mybatis/druid, which is incompatible with the reactive gateway.
    -->
    <dependency>
      <groupId>org.jeecgframework.boot</groupId>
      <artifactId>star-ai-boot-starter-secrets</artifactId>
    </dependency>
    <!--Gateway gateway dependency, built-in webflux-->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway</artifactId>
    </dependency>
    <!--Redis mode current limit-->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>

    <!--sentinel current limiting melting point degradation-->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-alibaba-sentinel-gateway</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
      <exclusions>
        <exclusion>
          <artifactId>fastjson</artifactId>
          <groupId>com.alibaba</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--sentinel integrates nacos as a data source-->
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-datasource-nacos</artifactId>
    </dependency>
    <!--Required by Spring Cloud Gateway GrpcSslConfigurer (NettyChannelBuilder); version unified by parent POM grpc.version-->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty</artifactId>
    </dependency>
    <!--health monitoring-->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--Swagger API documentation-->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-webflux-jakarta-spring-boot-starter</artifactId>
      <version>${knife4j-spring-boot-starter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <!--DynamicRouteLoader etc. use com.google.common.collect-->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
    </dependency>

    <!-- https://mvnrepository.com/artifact/com.googlecode.owasp-java-html-sanitizer/owasp-java-html-sanitizer -->
    <dependency>
      <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
      <artifactId>owasp-java-html-sanitizer</artifactId>
    </dependency>

    <!-- https://mvnrepository.com/artifact/org.owasp.esapi/esapi -->
    <dependency>
      <groupId>org.owasp.esapi</groupId>
      <artifactId>esapi</artifactId>
    </dependency>


    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
      <version>5.8.22</version>
    </dependency>

  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <layers>
            <enabled>true</enabled>
          </layers>
          <!--javax.annotation.Resource in tomcat annotations-api passed by rocketmq-common is incomplete, causing Spring 6 @Resource processing to fail-->
          <excludes>
            <exclude>
              <groupId>org.apache.tomcat</groupId>
              <artifactId>annotations-api</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>
</project>
